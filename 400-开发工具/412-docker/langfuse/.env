# ============================================
# Langfuse Docker 环境变量配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env：cp env.example .env
# 2. 修改以下配置为你的实际值
# 3. 重要：.env 文件包含敏感信息，不要提交到版本控制系统
# ============================================

# ============================================
# PostgreSQL 数据库配置（外部已有服务）
# ============================================
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 示例：postgresql://langfuse:password@localhost:5432/langfuse
# 注意：如果 PostgreSQL 在 Docker 容器中，使用容器名或 host.docker.internal
#       如果 PostgreSQL 在宿主机，Mac 上使用 host.docker.internal 或 127.0.0.1
# DATABASE_URL=postgresql://langfuse:password@host.docker.internal:5432/langfuse
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/langfuse
# 显式写出与 DATABASE_URL 一致，避免容器内变量未展开
DIRECT_URL=postgresql://postgres:postgres@host.docker.internal:5432/langfuse

# ============================================
# Redis 配置（外部已有服务）
# ============================================
# 格式1：redis://用户名:密码@主机:端口/数据库编号
# 格式2：redis://主机:端口/数据库编号（无密码）
# 格式3：redis://主机:端口（使用默认数据库）
# 示例：redis://localhost:6379/0
# 注意：如果 Redis 在 Docker 容器中，使用容器名或 host.docker.internal
#       如果 Redis 在宿主机，Mac 上使用 host.docker.internal 或 127.0.0.1
REDIS_CONNECTION_STRING=redis://host.docker.internal:6379/0

# ============================================
# ClickHouse 配置（Docker 容器内服务）
# ============================================
# 这些配置用于连接 docker-compose.yml 中的 ClickHouse 容器
# 通常不需要修改，除非你想使用外部 ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhousepassword
CLICKHOUSE_DB=default

# ============================================
# 认证和安全配置（必须随机生成）
# ============================================
# ⚠️ 重要：这些密钥必须随机生成，不能使用默认值
# 生成方式：
#   NEXTAUTH_SECRET: openssl rand -base64 32
#   SALT: openssl rand -hex 32
#   ENCRYPTION_KEY: openssl rand -hex 32

# NextAuth 会话密钥（用于 JWT 签名）
NEXTAUTH_SECRET=QOcNSNitDt72fqpB1AJAMiqfBM+/xFJMok6EDnAn/qA=

# API Key 哈希盐值
SALT=91f024f104ab969041001b2d9e054ce93733f7814414c7f1acee7fe9ab801507

# 敏感数据加密密钥（32 字节 hex）
ENCRYPTION_KEY=4e060fb4d85fd40db0e70fdb66a28e475b1a80ce5f8c79289d0388c66942ae5b

# 前端访问地址（必须与实际访问地址一致）
NEXTAUTH_URL=http://localhost:3000

# ============================================
# S3/Blob 存储配置（MinIO）
# ============================================
# MinIO 的访问凭证（与 docker-compose.yml 中的配置一致）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 存储桶名称
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-events
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse-media

# S3 区域（MinIO 可以设置为任意值）
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
LANGFUSE_S3_MEDIA_UPLOAD_REGION=us-east-1

# ============================================
# 功能开关
# ============================================
# 启用实验性功能（拥抱新特性）
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true

# 遥测数据收集（默认关闭，保护隐私）
TELEMETRY_ENABLED=false

# ============================================
# 日志配置
# ============================================
LANGFUSE_LOG_LEVEL=info
LANGFUSE_LOG_FORMAT=text

# ============================================
# 性能优化配置（Mac M1 优化）
# ============================================
# Node.js 内存限制（单位：MB）
# 根据你的 Mac 内存情况调整，建议 4096 或更高
NODE_OPTIONS=--max-old-space-size=4096

# ============================================
# 可选配置
# ============================================
# 如果需要从其他机器访问，设置为 0.0.0.0
# HOSTNAME=0.0.0.0

# 强制 HTTPS（生产环境建议开启）
# LANGFUSE_CSP_ENFORCE_HTTPS=true