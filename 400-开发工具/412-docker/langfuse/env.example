# ============================================
# Langfuse Docker 环境变量配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env：cp env.example .env
# 2. 修改以下配置为你的实际值
# 3. 重要：.env 文件包含敏感信息，不要提交到版本控制系统
# ============================================

# ============================================
# PostgreSQL 数据库配置（外部已有服务）
# ============================================
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 
# ⚠️ 重要：在 Docker 容器中，不要使用 127.0.0.1！
#   127.0.0.1 在容器中指向容器自身，无法访问其他容器
#
# 配置方式：
#   方式1：如果 PostgreSQL 在 Docker 容器中，且在同一网络，使用容器名
#         示例：postgresql://user:pass@postgres-pgvector-17:5432/dbname
#   方式2：如果 PostgreSQL 在 Docker 容器中，Mac 使用 host.docker.internal + 宿主机端口
#         示例：postgresql://user:pass@host.docker.internal:5433/dbname
#         注意：宿主机端口可能是 5433，不是 5432，请检查 docker ps 输出
#   方式3：如果 PostgreSQL 在宿主机上，Mac 使用 host.docker.internal
#         示例：postgresql://user:pass@host.docker.internal:5432/dbname
#
DATABASE_URL=postgresql://langfuse:password@host.docker.internal:5433/langfuse
DIRECT_URL=${DATABASE_URL}

# ============================================
# Redis 配置（外部已有服务）
# ============================================
# 格式1：redis://用户名:密码@主机:端口/数据库编号
# 格式2：redis://主机:端口/数据库编号（无密码）
# 格式3：redis://主机:端口（使用默认数据库）
#
# ⚠️ 重要：在 Docker 容器中，不要使用 127.0.0.1！
#   127.0.0.1 在容器中指向容器自身，无法访问其他容器
#
# 配置方式：
#   方式1：如果 Redis 在 Docker 容器中，且在同一网络，使用容器名
#         示例：redis://redis:6379/0
#   方式2：如果 Redis 在 Docker 容器中，Mac 使用 host.docker.internal
#         示例：redis://host.docker.internal:6379/0
#   方式3：如果 Redis 在宿主机上，Mac 使用 host.docker.internal
#         示例：redis://host.docker.internal:6379/0
#
REDIS_CONNECTION_STRING=redis://host.docker.internal:6379/0

# ============================================
# ClickHouse 配置（Docker 容器内服务）
# ============================================
# 这些配置用于连接 docker-compose.yml 中的 ClickHouse 容器
# 通常不需要修改，除非你想使用外部 ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhousepassword
CLICKHOUSE_DB=default

# ============================================
# 认证和安全配置（必须随机生成）
# ============================================
# ⚠️ 重要：这些密钥必须随机生成，不能使用默认值
# 生成方式：
#   NEXTAUTH_SECRET: openssl rand -base64 32
#   SALT: openssl rand -hex 32
#   ENCRYPTION_KEY: openssl rand -hex 32

# NextAuth 会话密钥（用于 JWT 签名）
NEXTAUTH_SECRET=请使用_openssl_rand_-base64_32_生成随机密钥

# API Key 哈希盐值
SALT=请使用_openssl_rand_-hex_32_生成随机密钥

# 敏感数据加密密钥（32 字节 hex）
ENCRYPTION_KEY=请使用_openssl_rand_-hex_32_生成随机密钥

# 前端访问地址（必须与实际访问地址一致）
NEXTAUTH_URL=http://localhost:3000

# ============================================
# S3/Blob 存储配置（MinIO）
# ============================================
# MinIO 的访问凭证（与 docker-compose.yml 中的配置一致）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 存储桶名称
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-events
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse-media

# S3 区域（MinIO 可以设置为任意值）
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
LANGFUSE_S3_MEDIA_UPLOAD_REGION=us-east-1

# ============================================
# 批量导出配置（Batch Export）
# ============================================
# 启用批量导出功能
LANGFUSE_S3_BATCH_EXPORT_ENABLED=true

# 批量导出存储桶名称
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse-exports

# 批量导出区域（MinIO 可以设置为任意值）
LANGFUSE_S3_BATCH_EXPORT_REGION=us-east-1

# 批量导出文件前缀（可选）
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/

# ============================================
# 功能开关
# ============================================
# 启用实验性功能（拥抱新特性）
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true

# 遥测数据收集（默认关闭，保护隐私）
TELEMETRY_ENABLED=false

# ============================================
# 日志配置
# ============================================
LANGFUSE_LOG_LEVEL=info
LANGFUSE_LOG_FORMAT=text

# ============================================
# 性能优化配置（Mac M1 优化）
# ============================================
# Node.js 内存限制（单位：MB）
# 根据你的 Mac 内存情况调整，建议 4096 或更高
NODE_OPTIONS=--max-old-space-size=4096

# ============================================
# 可选配置
# ============================================
# 如果需要从其他机器访问，设置为 0.0.0.0
# HOSTNAME=0.0.0.0

# 强制 HTTPS（生产环境建议开启）
# LANGFUSE_CSP_ENFORCE_HTTPS=true
